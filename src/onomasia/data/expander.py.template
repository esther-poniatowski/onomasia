r"""
Expansion of the macros of a notation into mathtext, generated by Onomasia; do not edit.

Matplotlib mathtext defines no macros, so figure code calls `expand` on each string before
mathtext reads it.

Sources: $SOURCES
"""

MACROS = $MACROS
"""Body, number of parameters and optional entry argument of each macro, by name."""

SOURCES = $SOURCE_DATA
"""Repository, commit and state of the records from which the macros were generated."""


def expand(text):
    """Replace each macro of the table by its body, its arguments substituted, until none remains."""
    for _ in range(len(MACROS) + 1):
        expanded = _expand_once(text)
        if expanded == text:
            return text
        text = expanded
    raise ValueError("the macros expand without end")


def _skip_spaces(text, position):
    """Skip the spaces before an argument, as TeX does."""
    while position < len(text) and text[position] == " ":
        position += 1
    return position


def _closing(text, position, opening, closing):
    """Position of the delimiter closing the group opened at `position`."""
    depth = 0
    for index in range(position, len(text)):
        if text[index] == opening:
            depth += 1
        elif text[index] == closing:
            depth -= 1
            if depth == 0:
                return index
    raise ValueError(f"unclosed {opening} at {position} in {text!r}")


def _argument(text, position):
    """Read one mandatory argument: a braced group, a control sequence, or one character."""
    position = _skip_spaces(text, position)
    if position >= len(text):
        raise ValueError(f"a macro lacks an argument in {text!r}")
    if text[position] == "{":
        end = _closing(text, position, "{", "}")
        return text[position + 1 : end], end + 1
    if text[position] == "\\":
        end = position + 1
        while end < len(text) and text[end].isalpha():
            end += 1
        end = max(end, position + 2)
        return text[position:end], end
    return text[position], position + 1


def _substitute(body, arguments):
    """Replace the parameters #1 to #9 of a body by their arguments."""
    out = []
    index = 0
    while index < len(body):
        if body[index] == "#" and index + 1 < len(body) and body[index + 1].isdigit():
            out.append(arguments[int(body[index + 1]) - 1])
            index += 2
        else:
            out.append(body[index])
            index += 1
    return "".join(out)


def _expand_once(text):
    """Expand each macro of a text once, from left to right."""
    out = []
    index = 0
    while index < len(text):
        if text[index] != "\\":
            out.append(text[index])
            index += 1
            continue
        end = index + 1
        while end < len(text) and text[end].isalpha():
            end += 1
        name = text[index + 1 : end]
        if not name or name not in MACROS:
            stop = max(end, index + 2)
            out.append(text[index:stop])
            index = stop
            continue
        body, parameters, optional = MACROS[name]
        arguments = []
        position = end
        if optional:
            start = _skip_spaces(text, position)
            if start < len(text) and text[start] == "[":
                closing = _closing(text, start, "[", "]")
                arguments.append(text[start + 1 : closing])
                position = closing + 1
            else:
                arguments.append("")
        while len(arguments) < parameters:
            argument, position = _argument(text, position)
            arguments.append(argument)
        out.append(_substitute(body, arguments))
        index = position
    return "".join(out)
